#!/bin/bash
#SBATCH --job-name=rtece-st178-bench
#SBATCH --partition=16V100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --qos=flood-1o2gpu
#SBATCH --time=03:55:00
#SBATCH --output=/home/gengjianrui/bin/logs/rtece-st178-bench-%j.out
#SBATCH --error=/home/gengjianrui/bin/logs/rtece-st178-bench-%j.err

set -eo pipefail
set -x
TACE_ROOT=/home/gengjianrui/bin/tace
ENV_DIR=/home/gengjianrui/bin/.venvs/tace-mace-cu126
TACE_PYTHON="${ENV_DIR}/bin/python"
PATH="${ENV_DIR}/bin:${PATH}"
TRAIN_FILE=runs/oc20neb_tace_mace/tece-distill-20260717/mixed_train_tw0.75.extxyz
VALID_FILE=/home/gengjianrui/workdir_sjtu-caoxiaoming/gengjianrui/Phorbol-mace-dpa4-training-accel/runs/oc20neb_fullcase200_fps_extxyz/valid.extxyz
TEACHER_VALID_FILE=runs/oc20neb_tace_mace/tece-distill-20260717/mixed_valid_tw0.75_regen.extxyz
LIMIT_CONFIGS=2048
VALID_LIMIT_CONFIGS=256
MAX_STEPS=20000
RESULTS_ROOT=runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/results
DIAGNOSTICS_ROOT=runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/diagnostics
mkdir -p /home/gengjianrui/bin/logs "${RESULTS_ROOT}" "${DIAGNOSTICS_ROOT}"
cd "${TACE_ROOT}"
"${TACE_PYTHON}" -V
nvidia-smi -L

# Benchmark stage178_l0_local_species
mkdir -p runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/diagnostics/stage178_l0_local_species
PYTHONPATH="${TACE_ROOT}:${PYTHONPATH:-}" python benchmarks/oc20neb_tace_mace/benchmark_rtece_scalar.py --model runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/results/stage178_l0_local_species/rtece_scalar_best.pt --configs "${VALID_FILE}" --output runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/diagnostics/stage178_l0_local_species/stage178_l0_local_species_dft_benchmark.json --variant stage178_l0_local_species --start-config 0 --limit-configs "${VALID_LIMIT_CONFIGS}" --measure-passes 5 --device cuda --default-dtype float32 --force-mode autograd --graph-construction-backend matscipy_neighborlist
PYTHONPATH="${TACE_ROOT}:${PYTHONPATH:-}" python benchmarks/oc20neb_tace_mace/benchmark_rtece_scalar.py --model runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/results/stage178_l0_local_species/rtece_scalar_best.pt --configs "${TEACHER_VALID_FILE}" --output runs/oc20neb_tace_mace/rtece-stage178-representation-upgrade/diagnostics/stage178_l0_local_species/stage178_l0_local_species_teacher_benchmark.json --variant stage178_l0_local_species --start-config 0 --limit-configs "${VALID_LIMIT_CONFIGS}" --measure-passes 5 --device cuda --default-dtype float32 --force-mode autograd --graph-construction-backend matscipy_neighborlist
